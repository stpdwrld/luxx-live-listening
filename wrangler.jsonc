
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxx-live-listening",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "PRESENCE",
      "id": "a87cdaa239334f1d8bf0d66b8e1eae75"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music",
      "database_id": "6dc6bcce-5dd0-42bf-8985-4225720dfe71"
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
